# =============================================================================
# ОСНОВНЫЕ НАСТРОЙКИ ПРИЛОЖЕНИЯ (APP_CONFIG)
# =============================================================================
APP_CONFIG__ENV=development
APP_CONFIG__NAME=Requify
APP_CONFIG__VERSION=0.1.0
APP_CONFIG__API_V1_STR=/api/v1
APP_CONFIG__HOST=0.0.0.0
APP_CONFIG__PORT=8000
APP_CONFIG__DEBUG=true

# =============================================================================
# НАСТРОЙКИ БАЗЫ ДАННЫХ POSTGRESQL (APP_CONFIG__DB)
# =============================================================================
# Основная база данных
APP_CONFIG__DB__NAME=requify-db
APP_CONFIG__DB__PASSWORD=postgres
APP_CONFIG__DB__USER=postgres
APP_CONFIG__DB__HOST=localhost
APP_CONFIG__DB__PORT=5432

# Настройки пула соединений для основной БД
APP_CONFIG__DB__POOL_SIZE=20
APP_CONFIG__DB__MAX_OVERFLOW=10
APP_CONFIG__DB__POOL_PRE_PING=true
APP_CONFIG__DB__POOL_RECYCLE=3600
APP_CONFIG__DB__ECHO=false
APP_CONFIG__DB__ECHO_POOL=false

# Тестовая база данных (APP_CONFIG__TEST_DB)
APP_CONFIG__TEST_DB__NAME=requify-test-db
APP_CONFIG__TEST_DB__PASSWORD=postgres
APP_CONFIG__TEST_DB__USER=postgres
APP_CONFIG__TEST_DB__HOST=localhost
APP_CONFIG__TEST_DB__PORT=5433

# Настройки пула соединений для тестовой БД
APP_CONFIG__TEST_DB__POOL_SIZE=20
APP_CONFIG__TEST_DB__MAX_OVERFLOW=10
APP_CONFIG__TEST_DB__POOL_PRE_PING=true
APP_CONFIG__TEST_DB__POOL_RECYCLE=3600
APP_CONFIG__TEST_DB__ECHO=false
APP_CONFIG__TEST_DB__ECHO_POOL=false

# =============================================================================
# НАСТРОЙКИ БЕЗОПАСНОСТИ (APP_CONFIG__SECURITY)
# =============================================================================
APP_CONFIG__SECURITY__SECRET_KEY=super-secret-key-change-in-production-minimum-32-characters
APP_CONFIG__SECURITY__ALGORITHM=HS256
APP_CONFIG__SECURITY__ACCESS_TOKEN_EXPIRE_MINUTES=30

# Настройки CORS
APP_CONFIG__CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080", "http://127.0.0.1:3000"]

# =============================================================================
# НАСТРОЙКИ ПЕРВОГО АДМИНИСТРАТОРА (APP_CONFIG__ADMIN)
# =============================================================================
APP_CONFIG__ADMIN__EMAIL=admin@requify.local
APP_CONFIG__ADMIN__PASSWORD=admin123
APP_CONFIG__ADMIN__NAME=Admin User

# =============================================================================
# НАСТРОЙКИ ИНТЕГРАЦИЙ (APP_CONFIG__INTEGRATIONS)
# =============================================================================
APP_CONFIG__INTEGRATIONS__TESTING_SYSTEM_API_URL=http://localhost:8001/api/v1
APP_CONFIG__INTEGRATIONS__TESTING_SYSTEM_API_KEY=test-api-key-change-in-production
APP_CONFIG__INTEGRATIONS__PROJECT_MANAGEMENT_API_URL=http://localhost:8002/api/v1
APP_CONFIG__INTEGRATIONS__PROJECT_MANAGEMENT_API_KEY=project-api-key-change-in-production

# =============================================================================
# НАСТРОЙКИ ЛОГИРОВАНИЯ (APP_CONFIG__LOGGING)
# =============================================================================
APP_CONFIG__LOGGING__LEVEL=INFO
APP_CONFIG__LOGGING__FILE=logs/requify.log
APP_CONFIG__LOGGING__MAX_SIZE=10485760
APP_CONFIG__LOGGING__BACKUP_COUNT=5

# =============================================================================
# НАСТРОЙКИ REDIS (APP_CONFIG__REDIS)
# =============================================================================
APP_CONFIG__REDIS__HOST=localhost
APP_CONFIG__REDIS__PORT=6379
APP_CONFIG__REDIS__DB=0
APP_CONFIG__REDIS__PASSWORD=

# =============================================================================
# НАСТРОЙКИ EMAIL (APP_CONFIG__EMAIL)
# =============================================================================
APP_CONFIG__EMAIL__SMTP_HOST=
APP_CONFIG__EMAIL__SMTP_PORT=587
APP_CONFIG__EMAIL__SMTP_USER=
APP_CONFIG__EMAIL__SMTP_PASSWORD=
APP_CONFIG__EMAIL__SMTP_TLS=true
APP_CONFIG__EMAIL__SMTP_SSL=false
APP_CONFIG__EMAIL__FROM_EMAIL=noreply@requify.local
APP_CONFIG__EMAIL__FROM_NAME=Requify

# =============================================================================
# НАСТРОЙКИ ФАЙЛОВОГО ХРАНИЛИЩА (APP_CONFIG__FILE_STORAGE)
# =============================================================================
APP_CONFIG__FILE_STORAGE__UPLOAD_DIR=uploads
APP_CONFIG__FILE_STORAGE__MAX_FILE_SIZE=10485760
APP_CONFIG__FILE_STORAGE__ALLOWED_EXTENSIONS=pdf,doc,docx,txt,jpg,jpeg,png,gif

# =============================================================================
# DOCKER ПЕРЕМЕННЫЕ ДЛЯ COMPOSE
# =============================================================================
POSTGRES_DB=requify-db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

POSTGRES_TEST_DB=requify-test-db
POSTGRES_TEST_USER=postgres
POSTGRES_TEST_PASSWORD=postgres

SECRET_KEY=super-secret-key-change-in-production-minimum-32-characters

