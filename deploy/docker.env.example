# =============================================================================
# Requify Docker Infrastructure Environment Configuration
# =============================================================================
# Copy this file to .env and modify values as needed
# cp docker.env.example .env

# =============================================================================
# Docker Compose Configuration
# =============================================================================
COMPOSE_PROJECT_NAME=requify

# =============================================================================
# Database Configuration
# =============================================================================
POSTGRES_DB=requify-db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_INITDB_ARGS=--encoding=UTF8 --lc-collate=C --lc-ctype=C --auth-host=md5
POSTGRES_HOST_AUTH_METHOD=md5

# Test Database
POSTGRES_TEST_DB=requify-test-db
POSTGRES_TEST_USER=postgres
POSTGRES_TEST_PASSWORD=postgres

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_PASSWORD=
REDIS_MAXMEMORY=512mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# =============================================================================
# MinIO Object Storage Configuration
# =============================================================================
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BROWSER_REDIRECT_URL=http://localhost:9001
MINIO_STORAGE_CLASS_STANDARD=EC:1

# MinIO Buckets (automatically created by mc container)
MINIO_BUCKET_UPLOADS=requify-uploads
MINIO_BUCKET_AVATARS=requify-avatars
MINIO_BUCKET_DOCUMENTS=requify-documents

# =============================================================================
# CDN Configuration
# =============================================================================
CDN_ENABLED=true
CDN_BASE_URL=http://localhost
CDN_CACHE_MAX_AGE=86400
CDN_AVATAR_CACHE_MAX_AGE=604800

# =============================================================================
# Application Configuration
# =============================================================================
APP_ENV=development
APP_DEBUG=true

# Backend API Configuration
APP_CONFIG__ENV=development
APP_CONFIG__DB__HOST=postgres
APP_CONFIG__DB__PORT=5432
APP_CONFIG__TEST_DB__HOST=postgres-test
APP_CONFIG__TEST_DB__PORT=5432
APP_CONFIG__REDIS__HOST=redis
APP_CONFIG__REDIS__PORT=6379
APP_CONFIG__REDIS__DB=0
APP_CONFIG__REDIS__PASSWORD=

# File Storage & CDN Integration
APP_CONFIG__FILE_STORAGE__USE_MINIO=true
APP_CONFIG__FILE_STORAGE__MINIO_ENDPOINT=minio:9000
APP_CONFIG__FILE_STORAGE__MINIO_ACCESS_KEY=admin
APP_CONFIG__FILE_STORAGE__MINIO_SECRET_KEY=minioadmin123
APP_CONFIG__FILE_STORAGE__MINIO_SECURE=false
APP_CONFIG__FILE_STORAGE__CDN_ENABLED=true
APP_CONFIG__FILE_STORAGE__CDN_BASE_URL=http://localhost
APP_CONFIG__FILE_STORAGE__CDN_AVATAR_PATH=/avatars
APP_CONFIG__FILE_STORAGE__CDN_UPLOADS_PATH=/cdn/uploads
APP_CONFIG__FILE_STORAGE__CDN_DOCUMENTS_PATH=/cdn/documents

# =============================================================================
# Security Configuration
# =============================================================================
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30

# Auth0 Configuration (optional)
APP_CONFIG__AUTH0__ENABLED=false
APP_CONFIG__AUTH0__DOMAIN=your-tenant.auth0.com
APP_CONFIG__AUTH0__CLIENT_ID=your-client-id
APP_CONFIG__AUTH0__CLIENT_SECRET=your-client-secret

# =============================================================================
# Email Configuration
# =============================================================================
# Development (MailHog for local development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@requify.local
SMTP_FROM_NAME=Requify System

# Email settings for backend
APP_CONFIG__EMAIL__SMTP_HOST=localhost
APP_CONFIG__EMAIL__SMTP_PORT=1025
APP_CONFIG__EMAIL__SMTP_USER=
APP_CONFIG__EMAIL__SMTP_PASSWORD=
APP_CONFIG__EMAIL__SMTP_TLS=false
APP_CONFIG__EMAIL__FROM_EMAIL=noreply@requify.local
APP_CONFIG__EMAIL__FROM_NAME=Requify System

# =============================================================================
# Network Configuration
# =============================================================================
# Docker networks (configured in docker-compose.yml)
REQUIFY_NETWORK_NAME=requify_network

# =============================================================================
# Performance & Monitoring
# =============================================================================
# NGINX Configuration
NGINX_WORKER_PROCESSES=auto
NGINX_WORKER_CONNECTIONS=1024

# Redis CDN Cache
REDIS_CDN_MAXMEMORY=256mb
REDIS_CDN_MAXMEMORY_POLICY=allkeys-lru

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=INFO
APP_CONFIG__LOGGING__LEVEL=INFO
APP_CONFIG__LOGGING__FORMAT=detailed

# =============================================================================
# File Upload Limits
# =============================================================================
APP_CONFIG__UPLOAD__MAX_FILE_SIZE=10485760
APP_CONFIG__UPLOAD__ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf,doc,docx

# Avatar specific settings
APP_CONFIG__FILE_STORAGE__AVATAR_MAX_SIZE=2097152
APP_CONFIG__FILE_STORAGE__AVATAR_EXTENSIONS=jpg,jpeg,png
APP_CONFIG__FILE_STORAGE__AVATAR_SIZES=128,256,512

# =============================================================================
# Development Overrides
# =============================================================================
# API Configuration
APP_CONFIG__API__CORS_ORIGINS=http://localhost:3000,http://localhost:80
APP_CONFIG__API__DOCS_URL=/docs
APP_CONFIG__API__REDOC_URL=/redoc

# =============================================================================
# Production Overrides (uncomment for production)
# =============================================================================
# APP_ENV=production
# APP_DEBUG=false
# CDN_BASE_URL=https://cdn.yourdomain.com
# MINIO_ROOT_PASSWORD=very-strong-password-change-this
# JWT_SECRET_KEY=very-strong-jwt-secret-change-this
# POSTGRES_PASSWORD=very-strong-db-password

# Production Email (Gmail example)
# APP_CONFIG__EMAIL__SMTP_HOST=smtp.gmail.com
# APP_CONFIG__EMAIL__SMTP_PORT=587
# APP_CONFIG__EMAIL__SMTP_USER=your-email@gmail.com
# APP_CONFIG__EMAIL__SMTP_PASSWORD=your-app-password
# APP_CONFIG__EMAIL__SMTP_TLS=true
# APP_CONFIG__EMAIL__FROM_EMAIL=noreply@yourdomain.com

# Production CORS
# APP_CONFIG__API__CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# =============================================================================
# External Services (production with cloud storage)
# =============================================================================
# AWS S3 Configuration
# APP_CONFIG__FILE_STORAGE__MINIO_ENDPOINT=s3.amazonaws.com
# APP_CONFIG__FILE_STORAGE__MINIO_ACCESS_KEY=your-aws-access-key
# APP_CONFIG__FILE_STORAGE__MINIO_SECRET_KEY=your-aws-secret-key
# APP_CONFIG__FILE_STORAGE__MINIO_SECURE=true
# APP_CONFIG__FILE_STORAGE__MINIO_REGION=us-east-1

# DigitalOcean Spaces Configuration
# APP_CONFIG__FILE_STORAGE__MINIO_ENDPOINT=nyc3.digitaloceanspaces.com
# APP_CONFIG__FILE_STORAGE__MINIO_ACCESS_KEY=your-do-access-key
# APP_CONFIG__FILE_STORAGE__MINIO_SECRET_KEY=your-do-secret-key
# APP_CONFIG__FILE_STORAGE__MINIO_SECURE=true

# CloudFlare / AWS CloudFront CDN
# CDN_BASE_URL=https://cdn.yourdomain.com
# CDN_CACHE_MAX_AGE=86400
# APP_CONFIG__FILE_STORAGE__CDN_BASE_URL=https://cdn.yourdomain.com

# =============================================================================
# Monitoring & Health Checks
# =============================================================================
# Health check intervals (defined in docker-compose.yml)
POSTGRES_HEALTH_CHECK_INTERVAL=10s
REDIS_HEALTH_CHECK_INTERVAL=10s
MINIO_HEALTH_CHECK_INTERVAL=30s

# =============================================================================
# Notes
# =============================================================================
# 1. For development: copy this file to .env in the deploy/docker directory
# 2. For production: review all commented production settings
# 3. Change all default passwords and secrets before production deployment
# 4. Configure external CDN and object storage for production scaling
# 5. Set up proper SSL certificates for HTTPS in production 