# Production Backend Dockerfile - Multi-stage build
FROM python:3.13-slim as builder

# Системные зависимости для сборки включая библиотеки для Pillow
RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    libjpeg-dev \
    libpng-dev \
    libwebp-dev \
    libtiff5-dev \
    libfreetype6-dev \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# Устанавливаем Poetry
RUN pip install poetry==1.8.3

# Настройки Poetry
ENV POETRY_NO_INTERACTION=1 \
    POETRY_VENV_IN_PROJECT=1 \
    POETRY_CACHE_DIR=/tmp/poetry_cache

WORKDIR /app

# Копируем зависимости из backend директории и устанавливаем их
COPY backend/pyproject.toml backend/poetry.lock* ./
RUN poetry config virtualenvs.create true && \
    poetry install --only=main && \
    rm -rf $POETRY_CACHE_DIR

# Production stage
FROM python:3.13-slim as production

# Минимальные системные зависимости включая runtime библиотеки для Pillow
RUN apt-get update && apt-get install -y \
    libpq-dev \
    curl \
    libjpeg62-turbo \
    libpng16-16 \
    libwebp7 \
    libtiff6 \
    libfreetype6 \
    zlib1g \
    && rm -rf /var/lib/apt/lists/*

# Создаем пользователя раньше
RUN groupadd -r requify && useradd -r -g requify requify

WORKDIR /app

# Копируем виртуальное окружение из builder stage
COPY --from=builder /app/.venv /app/.venv

# Активируем виртуальное окружение
ENV PATH="/app/.venv/bin:$PATH"

# Копируем код приложения из backend директории
COPY backend/app/ ./app/
COPY backend/alembic.ini backend/.env* ./

# Создаем директории с правильными правами и устанавливаем права
RUN mkdir -p logs uploads static backups && \
    chown -R requify:requify /app && \
    chmod -R 755 /app

USER requify

EXPOSE 8000

# Здоровая проверка
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Production команда с Gunicorn
CMD ["gunicorn", "app.main:app", "-w", "4", "-k", "uvicorn.workers.UvicornWorker", "--bind", "0.0.0.0:8000"] 