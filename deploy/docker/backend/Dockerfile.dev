# Development Backend Dockerfile
FROM python:3.13-slim as base

# Системные зависимости
RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Устанавливаем Poetry
RUN pip install poetry==1.8.3

# Настройки Poetry для разработки
ENV POETRY_NO_INTERACTION=1 \
    POETRY_VENV_IN_PROJECT=1 \
    POETRY_CACHE_DIR=/tmp/poetry_cache

WORKDIR /app

# Копируем файлы зависимостей и конфигурации из backend папки
COPY backend/pyproject.toml backend/poetry.lock* ./
COPY backend/alembic.ini ./alembic.ini

# Устанавливаем зависимости с dev пакетами
RUN poetry config virtualenvs.create false && \
    poetry install --with dev && \
    rm -rf $POETRY_CACHE_DIR

# Копируем весь backend код
COPY backend/ .

# Создаем пользователя и группу
RUN groupadd -r requify && useradd -r -g requify -s /bin/bash requify

# Создаем необходимые директории с правильными правами
RUN mkdir -p logs uploads static backups && \
    chown -R requify:requify /app && \
    chmod -R 755 /app

# Устанавливаем переменные окружения для Python
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

USER requify

EXPOSE 8000

# Hot reload для разработки с правильным путем к main модулю
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload", "--log-level", "debug"] 