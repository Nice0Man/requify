# Development Dockerfile for Requify Frontend
FROM node:24-alpine

# Set work directory
WORKDIR /app

# Install system dependencies  
RUN apk add --no-cache \
    git \
    openssh-client \
    curl \
    && rm -rf /var/cache/apk/*

# Create user
RUN addgroup -g 1001 -S frontend && \
    adduser -S -u 1001 -G frontend -h /app frontend

# Copy package files first to leverage Docker cache (correct path from project root)
COPY frontend/package.json frontend/package-lock.json* ./

# Install dependencies as root first, then fix permissions
RUN npm ci --no-audit --no-fund && \
    chown -R frontend:frontend /app

# Copy source code (correct path from project root)
COPY frontend ./

# Set final permissions
RUN chown -R frontend:frontend /app

# Expose port
EXPOSE 3000
EXPOSE 24678

# Switch to non-root user
USER frontend

# Start development server
CMD ["npm", "run", "dev", "--", "--host", "http://requify.local"]