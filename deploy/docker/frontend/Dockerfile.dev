# Development Frontend Dockerfile
FROM node:20-alpine

WORKDIR /app

# Create non-root user with home directory for npm cache
RUN addgroup -g 1001 -S frontend && \
    adduser -S -u 1001 -G frontend -h /home/frontend frontend

# Install system dependencies
RUN apk add --no-cache \
    git \
    openssh-client \
    && rm -rf /var/cache/apk/*

# Copy package files first to leverage Docker cache
COPY package*.json ./
COPY yarn.lock* ./

# Install dependencies as root to ensure permissions
RUN npm ci --include=dev && \
    npm cache clean --force

# Copy application code
COPY . .

# Create necessary directories and set permissions
RUN mkdir -p node_modules/.cache && \
    chown -R frontend:frontend /app && \
    chmod -R 755 /app

# Switch to non-root user
USER frontend

# Set environment variables
ENV NODE_ENV=development
ENV VITE_HOST=0.0.0.0
ENV VITE_PORT=3000

EXPOSE 3000

# Hot reload for development with proper host binding
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3000"]