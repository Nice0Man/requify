{% extends "base.html.jinja" %}

{% block title %}{{ subject | default('Уведомление от Requify') }}{% endblock %}

{% block content %}
<h1 class="email-title">
    <span class="icon">{{ notification_icon | default('📱') }}</span>{{ notification_title | default('Уведомление от Requify') }}
</h1>

<p class="email-text">
    Здравствуйте, <strong>{{ user_name | default(user_email) }}</strong>!
</p>

<p class="email-text">
    {{ notification_message | default('У нас есть важная информация для вас.') }}
</p>

{% if notification_type == 'success' %}
<div class="alert alert-success">
    <div class="alert-title">
        <span class="icon">✅</span>Действие выполнено успешно
    </div>
    <div class="alert-text">
        {{ success_message | default('Операция была завершена успешно.') }}
    </div>
</div>
{% elif notification_type == 'info' %}
<div class="alert alert-info">
    <div class="alert-title">
        <span class="icon">ℹ️</span>Информация
    </div>
    <div class="alert-text">
        {{ info_message | default('Информационное сообщение.') }}
    </div>
</div>
{% elif notification_type == 'warning' %}
<div class="alert alert-warning">
    <div class="alert-title">
        <span class="icon">⚠️</span>Важное уведомление
    </div>
    <div class="alert-text">
        {{ warning_message | default('Требует вашего внимания.') }}
    </div>
</div>
{% endif %}

{% if changes_list %}
<div class="changes-section">
    <h3 class="section-title">
        <span class="icon">📝</span>Изменения
    </h3>
    
    <div class="changes-list">
        {% for change in changes_list %}
        <div class="change-item">
            <div class="change-icon">{{ change.icon | default('•') }}</div>
            <div class="change-content">
                <div class="change-title">{{ change.title }}</div>
                {% if change.description %}
                <div class="change-description">{{ change.description }}</div>
                {% endif %}
                {% if change.old_value and change.new_value %}
                <div class="change-values">
                    <span class="old-value">{{ change.old_value }}</span>
                    <span class="arrow">→</span>
                    <span class="new-value">{{ change.new_value }}</span>
                </div>
                {% endif %}
            </div>
            {% if change.timestamp %}
            <div class="change-timestamp">{{ change.timestamp }}</div>
            {% endif %}
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}

{% if project_info %}
<div class="project-context">
    <h3 class="section-title">
        <span class="icon">📁</span>Контекст проекта
    </h3>
    
    <div class="project-card">
        <div class="project-header">
            <div class="project-name">{{ project_info.name }}</div>
            {% if project_info.status %}
            <div class="project-status {{ project_info.status }}">{{ project_info.status | upper }}</div>
            {% endif %}
        </div>
        
        {% if project_info.description %}
        <div class="project-description">{{ project_info.description }}</div>
        {% endif %}
        
        {% if project_info.details %}
        <div class="project-details">
            {% for detail in project_info.details %}
            <div class="detail-row">
                <span class="detail-label">{{ detail.label }}:</span>
                <span class="detail-value">{{ detail.value }}</span>
            </div>
            {% endfor %}
        </div>
        {% endif %}
    </div>
</div>
{% endif %}

{% if next_steps %}
<div class="next-steps-section">
    <h3 class="section-title">
        <span class="icon">🎯</span>Следующие шаги
    </h3>
    
    <div class="steps-list">
        {% for step in next_steps %}
        <div class="step-item {{ step.status | default('') }}">
            <div class="step-number">{{ loop.index }}</div>
            <div class="step-content">
                <div class="step-title">{{ step.title }}</div>
                {% if step.description %}
                <div class="step-description">{{ step.description }}</div>
                {% endif %}
                {% if step.deadline %}
                <div class="step-deadline">
                    <span class="icon">⏰</span>Срок: {{ step.deadline }}
                </div>
                {% endif %}
            </div>
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}

{% if action_required %}
<div class="action-required">
    <div class="alert alert-warning">
        <div class="alert-title">
            <span class="icon">👆</span>Требуется действие
        </div>
        <div class="alert-text">
            {{ action_required.message }}
        </div>
    </div>
    
    {% if action_required.deadline %}
    <div class="deadline-notice">
        <span class="icon">⏰</span>
        <strong>Срок выполнения:</strong> {{ action_required.deadline }}
    </div>
    {% endif %}
</div>
{% endif %}

{% if action_buttons %}
<div class="button-container">
    {% for button in action_buttons %}
    <a href="{{ button.url }}" class="button {{ button.style | default('') }}">
        <span class="icon">{{ button.icon | default('🔗') }}</span>{{ button.text }}
    </a>
    {% endfor %}
</div>
{% endif %}

{% if summary %}
<div class="alert alert-info">
    <div class="alert-title">
        <span class="icon">📊</span>Сводка
    </div>
    <div class="alert-text">
        {{ summary | safe }}
    </div>
</div>
{% endif %}

<div class="help-section">
    <p class="email-text">
        Если у вас есть вопросы или нужна помощь, вы можете:
    </p>
    
    <div class="help-options">
        <div class="help-option">
            <span class="icon">📚</span>
            <a href="{{ help_url | default('#') }}" class="help-link">Посмотреть документацию</a>
        </div>
        
        <div class="help-option">
            <span class="icon">💬</span>
            <a href="{{ support_url | default('#') }}" class="help-link">Связаться с поддержкой</a>
        </div>
        
        {% if dashboard_url %}
        <div class="help-option">
            <span class="icon">🏠</span>
            <a href="{{ dashboard_url }}" class="help-link">Перейти в панель управления</a>
        </div>
        {% endif %}
    </div>
</div>

<style>
/* Changes section */
.changes-section {
    margin: 32px 0;
}

.section-title {
    font-size: 20px;
    font-weight: 600;
    color: #333;
    margin-bottom: 16px;
    border-bottom: 2px solid #e0e0e0;
    padding-bottom: 8px;
}

.changes-list {
    list-style: none;
    padding: 0;
}

.change-item {
    display: flex;
    align-items: flex-start;
    padding: 16px;
    margin: 12px 0;
    background: #f8f9fa;
    border-radius: 8px;
    border-left: 4px solid #2196f3;
}

.change-icon {
    font-size: 20px;
    margin-right: 16px;
    margin-top: 4px;
}

.change-content {
    flex: 1;
}

.change-title {
    font-weight: 600;
    color: #333;
    margin-bottom: 4px;
}

.change-description {
    color: #666;
    font-size: 14px;
    margin-bottom: 8px;
}

.change-values {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', monospace;
    font-size: 14px;
}

.old-value {
    background: #ffebee;
    color: #d32f2f;
    padding: 4px 8px;
    border-radius: 4px;
}

.new-value {
    background: #e8f5e8;
    color: #2e7d32;
    padding: 4px 8px;
    border-radius: 4px;
}

.arrow {
    color: #666;
    font-weight: bold;
}

.change-timestamp {
    font-size: 12px;
    color: #999;
    margin-left: 16px;
    margin-top: 4px;
}

/* Project context */
.project-context {
    margin: 32px 0;
}

.project-card {
    background: #f8f9fa;
    border-radius: 12px;
    padding: 20px;
    border-left: 4px solid #2196f3;
}

.project-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
}

.project-name {
    font-size: 18px;
    font-weight: 700;
    color: #333;
}

.project-status {
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
}

.project-status.active {
    background: #e8f5e8;
    color: #2e7d32;
}

.project-status.completed {
    background: #e3f2fd;
    color: #1976d2;
}

.project-status.on-hold {
    background: #fff8e1;
    color: #f57c00;
}

.project-description {
    color: #666;
    margin-bottom: 16px;
    line-height: 1.6;
}

.project-details {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 8px;
}

.detail-row {
    display: flex;
    justify-content: space-between;
}

.detail-label {
    font-weight: 600;
    color: #666;
}

.detail-value {
    color: #333;
}

/* Next steps */
.next-steps-section {
    margin: 32px 0;
}

.steps-list {
    list-style: none;
    padding: 0;
}

.step-item {
    display: flex;
    align-items: flex-start;
    padding: 16px;
    margin: 12px 0;
    background: #f8f9fa;
    border-radius: 8px;
    border-left: 4px solid #ffc107;
}

.step-item.completed {
    border-left-color: #4caf50;
    background: #f1f8e9;
}

.step-item.urgent {
    border-left-color: #f44336;
    background: #ffebee;
}

.step-number {
    width: 32px;
    height: 32px;
    background: #2196f3;
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    margin-right: 16px;
    flex-shrink: 0;
}

.step-item.completed .step-number {
    background: #4caf50;
}

.step-item.urgent .step-number {
    background: #f44336;
}

.step-content {
    flex: 1;
}

.step-title {
    font-weight: 600;
    color: #333;
    margin-bottom: 4px;
}

.step-description {
    color: #666;
    font-size: 14px;
    margin-bottom: 8px;
}

.step-deadline {
    font-size: 14px;
    color: #f57c00;
    font-weight: 500;
}

/* Action required */
.action-required {
    margin: 32px 0;
}

.deadline-notice {
    margin-top: 16px;
    padding: 12px 16px;
    background: #fff8e1;
    border-radius: 8px;
    border-left: 4px solid #ff9800;
    color: #e65100;
}

/* Help section */
.help-section {
    margin: 40px 0;
    padding: 24px;
    background: #f8f9fa;
    border-radius: 12px;
    border: 1px solid #e0e0e0;
}

.help-options {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    margin-top: 16px;
}

.help-option {
    display: flex;
    align-items: center;
    padding: 12px;
    background: white;
    border-radius: 8px;
    border: 1px solid #e0e0e0;
}

.help-option .icon {
    margin-right: 12px;
    font-size: 18px;
}

.help-link {
    color: #1976d2;
    text-decoration: none;
    font-weight: 500;
}

.help-link:hover {
    text-decoration: underline;
}

@media (max-width: 600px) {
    .project-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
    }
    
    .project-details {
        grid-template-columns: 1fr;
    }
    
    .help-options {
        grid-template-columns: 1fr;
    }
    
    .change-item, .step-item {
        padding: 12px;
    }
    
    .change-values {
        flex-direction: column;
        align-items: flex-start;
        gap: 4px;
    }
}
</style>
{% endblock %} 