# Production Environment Configuration for Requify
# Configure with real SMTP provider

APP_CONFIG__ENV=production

# Database Configuration
APP_CONFIG__DB__HOST=your-production-db-host
APP_CONFIG__DB__PORT=5432
APP_CONFIG__DB__NAME=requify_prod
APP_CONFIG__DB__USER=requify_user
APP_CONFIG__DB__PASSWORD=your-secure-password

# Redis Configuration
APP_CONFIG__REDIS__HOST=your-redis-host
APP_CONFIG__REDIS__PORT=6379
APP_CONFIG__REDIS__DB=0
APP_CONFIG__REDIS__PASSWORD=your-redis-password

# Security Configuration - CHANGE THESE IN PRODUCTION!
APP_CONFIG__SECURITY__SECRET_KEY=your-super-secure-secret-key-generate-new-one
APP_CONFIG__SECURITY__ACCESS_TOKEN_EXPIRE_MINUTES=15
APP_CONFIG__SECURITY__REFRESH_TOKEN_EXPIRE_DAYS=7

# Email Configuration - Gmail Example (choose one provider)
APP_CONFIG__EMAIL__SMTP_HOST=smtp.gmail.com
APP_CONFIG__EMAIL__SMTP_PORT=587
APP_CONFIG__EMAIL__SMTP_USER=your-email@gmail.com
APP_CONFIG__EMAIL__SMTP_PASSWORD=your-app-password
APP_CONFIG__EMAIL__SMTP_TLS=true
APP_CONFIG__EMAIL__SMTP_SSL=false
APP_CONFIG__EMAIL__FROM_EMAIL=noreply@yourdomain.com
APP_CONFIG__EMAIL__FROM_NAME=Your Company Name

# Alternative: SendGrid Configuration
# APP_CONFIG__EMAIL__SMTP_HOST=smtp.sendgrid.net
# APP_CONFIG__EMAIL__SMTP_PORT=587
# APP_CONFIG__EMAIL__SMTP_USER=apikey
# APP_CONFIG__EMAIL__SMTP_PASSWORD=your-sendgrid-api-key
# APP_CONFIG__EMAIL__SMTP_TLS=true

# Alternative: AWS SES Configuration
# APP_CONFIG__EMAIL__SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# APP_CONFIG__EMAIL__SMTP_PORT=587
# APP_CONFIG__EMAIL__SMTP_USER=your-aws-access-key
# APP_CONFIG__EMAIL__SMTP_PASSWORD=your-aws-secret-key
# APP_CONFIG__EMAIL__SMTP_TLS=true

# Alternative: Outlook/Office365 Configuration
# APP_CONFIG__EMAIL__SMTP_HOST=smtp-mail.outlook.com
# APP_CONFIG__EMAIL__SMTP_PORT=587
# APP_CONFIG__EMAIL__SMTP_USER=your-email@outlook.com
# APP_CONFIG__EMAIL__SMTP_PASSWORD=your-password
# APP_CONFIG__EMAIL__SMTP_TLS=true

# API Configuration
APP_CONFIG__API__CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
APP_CONFIG__API__DOCS_URL=
APP_CONFIG__API__REDOC_URL=

# Logging
APP_CONFIG__LOGGING__LEVEL=INFO
APP_CONFIG__LOGGING__FORMAT=json 