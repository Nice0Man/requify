# =============================================================================
# Requify Backend Environment Configuration
# =============================================================================

# Application Environment
APP_CONFIG__ENV=development

# =============================================================================
# Database Configuration
# =============================================================================
APP_CONFIG__DB__HOST=localhost
APP_CONFIG__DB__PORT=5432
APP_CONFIG__DB__NAME=requify_dev
APP_CONFIG__DB__USER=requify_user
APP_CONFIG__DB__PASSWORD=requify_password

# Test Database
APP_CONFIG__TEST_DB__HOST=localhost
APP_CONFIG__TEST_DB__PORT=5433
APP_CONFIG__TEST_DB__NAME=requify_test_db
APP_CONFIG__TEST_DB__USER=postgres
APP_CONFIG__TEST_DB__PASSWORD=postgres

# =============================================================================
# Redis Configuration
# =============================================================================
APP_CONFIG__REDIS__HOST=localhost
APP_CONFIG__REDIS__PORT=6379
APP_CONFIG__REDIS__DB=0
APP_CONFIG__REDIS__PASSWORD=

# =============================================================================
# Security Configuration
# =============================================================================
APP_CONFIG__SECURITY__SECRET_KEY=your-super-secret-key-change-this-in-production
APP_CONFIG__SECURITY__ACCESS_TOKEN_EXPIRE_MINUTES=30
APP_CONFIG__SECURITY__REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# Auth0 OAuth2 Configuration
# =============================================================================
APP_CONFIG__AUTH0__ENABLED=false
APP_CONFIG__AUTH0__DOMAIN=your-tenant.auth0.com
APP_CONFIG__AUTH0__CLIENT_ID=your-client-id
APP_CONFIG__AUTH0__CLIENT_SECRET=your-client-secret
APP_CONFIG__AUTH0__AUDIENCE=https://api.requify.com
APP_CONFIG__AUTH0__MANAGEMENT_CLIENT_ID=your-management-client-id
APP_CONFIG__AUTH0__MANAGEMENT_CLIENT_SECRET=your-management-client-secret

# =============================================================================
# Email Configuration
# =============================================================================

# Development Mode (uses MailHog when running with Docker)
APP_CONFIG__EMAIL__SMTP_HOST=localhost
APP_CONFIG__EMAIL__SMTP_PORT=1025
APP_CONFIG__EMAIL__SMTP_USER=
APP_CONFIG__EMAIL__SMTP_PASSWORD=
APP_CONFIG__EMAIL__SMTP_TLS=false
APP_CONFIG__EMAIL__SMTP_SSL=false
APP_CONFIG__EMAIL__FROM_EMAIL=noreply@requify.local
APP_CONFIG__EMAIL__FROM_NAME=Requify System

# Production Gmail Configuration (uncomment and configure for production)
# APP_CONFIG__EMAIL__SMTP_HOST=smtp.gmail.com
# APP_CONFIG__EMAIL__SMTP_PORT=587
# APP_CONFIG__EMAIL__SMTP_USER=your-email@gmail.com
# APP_CONFIG__EMAIL__SMTP_PASSWORD=your-app-password
# APP_CONFIG__EMAIL__SMTP_TLS=true
# APP_CONFIG__EMAIL__FROM_EMAIL=noreply@yourdomain.com
# APP_CONFIG__EMAIL__FROM_NAME=Your Company Name

# Production SendGrid Configuration (alternative)
# APP_CONFIG__EMAIL__SMTP_HOST=smtp.sendgrid.net
# APP_CONFIG__EMAIL__SMTP_PORT=587
# APP_CONFIG__EMAIL__SMTP_USER=apikey
# APP_CONFIG__EMAIL__SMTP_PASSWORD=your-sendgrid-api-key
# APP_CONFIG__EMAIL__SMTP_TLS=true

# Production AWS SES Configuration (alternative)
# APP_CONFIG__EMAIL__SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# APP_CONFIG__EMAIL__SMTP_PORT=587
# APP_CONFIG__EMAIL__SMTP_USER=your-aws-access-key
# APP_CONFIG__EMAIL__SMTP_PASSWORD=your-aws-secret-key
# APP_CONFIG__EMAIL__SMTP_TLS=true

# =============================================================================
# Logging Configuration
# =============================================================================
APP_CONFIG__LOGGING__LEVEL=INFO
APP_CONFIG__LOGGING__FORMAT=detailed

# =============================================================================
# File Upload Configuration
# =============================================================================
APP_CONFIG__UPLOAD__MAX_FILE_SIZE=10485760
APP_CONFIG__UPLOAD__ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf,doc,docx

# =============================================================================
# API Configuration
# =============================================================================
APP_CONFIG__API__CORS_ORIGINS=http://localhost:3000,http://localhost:80
APP_CONFIG__API__DOCS_URL=/docs
APP_CONFIG__API__REDOC_URL=/redoc

# =============================================================================
# File Storage & CDN Configuration
# =============================================================================

# File Storage Settings
APP_CONFIG__FILE_STORAGE__UPLOAD_DIR=uploads
APP_CONFIG__FILE_STORAGE__QUARANTINE_DIR=quarantine
APP_CONFIG__FILE_STORAGE__MAX_FILE_SIZE=10485760
APP_CONFIG__FILE_STORAGE__ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf,doc,docx,txt
APP_CONFIG__FILE_STORAGE__AVATAR_MAX_SIZE=2097152
APP_CONFIG__FILE_STORAGE__AVATAR_EXTENSIONS=jpg,jpeg,png
APP_CONFIG__FILE_STORAGE__AVATAR_SIZES=128,256,512

# MinIO Object Storage Configuration
APP_CONFIG__FILE_STORAGE__USE_MINIO=false
APP_CONFIG__FILE_STORAGE__MINIO_ENDPOINT=localhost:9000
APP_CONFIG__FILE_STORAGE__MINIO_ACCESS_KEY=admin
APP_CONFIG__FILE_STORAGE__MINIO_SECRET_KEY=minioadmin123
APP_CONFIG__FILE_STORAGE__MINIO_SECURE=false
APP_CONFIG__FILE_STORAGE__MINIO_REGION=us-east-1
APP_CONFIG__FILE_STORAGE__MINIO_BUCKET_UPLOADS=requify-uploads
APP_CONFIG__FILE_STORAGE__MINIO_BUCKET_AVATARS=requify-avatars
APP_CONFIG__FILE_STORAGE__MINIO_BUCKET_DOCUMENTS=requify-documents

# CDN Configuration
APP_CONFIG__FILE_STORAGE__CDN_ENABLED=false
APP_CONFIG__FILE_STORAGE__CDN_BASE_URL=http://localhost
APP_CONFIG__FILE_STORAGE__CDN_AVATAR_PATH=/avatars
APP_CONFIG__FILE_STORAGE__CDN_UPLOADS_PATH=/cdn/uploads
APP_CONFIG__FILE_STORAGE__CDN_DOCUMENTS_PATH=/cdn/documents

# Cache & Performance Settings
APP_CONFIG__FILE_STORAGE__AVATAR_CACHE_MAX_AGE=3600
APP_CONFIG__FILE_STORAGE__ENABLE_COMPRESSION=true

# =============================================================================
# Production CDN Configuration (uncomment for production with external CDN)
# =============================================================================

# External S3-compatible storage (AWS S3, DigitalOcean Spaces, etc.)
# APP_CONFIG__FILE_STORAGE__USE_MINIO=true
# APP_CONFIG__FILE_STORAGE__MINIO_ENDPOINT=s3.amazonaws.com
# APP_CONFIG__FILE_STORAGE__MINIO_ACCESS_KEY=your-aws-access-key
# APP_CONFIG__FILE_STORAGE__MINIO_SECRET_KEY=your-aws-secret-key
# APP_CONFIG__FILE_STORAGE__MINIO_SECURE=true
# APP_CONFIG__FILE_STORAGE__MINIO_REGION=us-east-1

# CloudFlare or AWS CloudFront CDN
# APP_CONFIG__FILE_STORAGE__CDN_ENABLED=true
# APP_CONFIG__FILE_STORAGE__CDN_BASE_URL=https://cdn.yourdomain.com
# APP_CONFIG__FILE_STORAGE__AVATAR_CACHE_MAX_AGE=86400

# =============================================================================
# Development Docker Configuration
# =============================================================================

# For development with docker-compose (automatically configured in docker-compose.yml)
# APP_CONFIG__FILE_STORAGE__USE_MINIO=true
# APP_CONFIG__FILE_STORAGE__MINIO_ENDPOINT=minio:9000
# APP_CONFIG__FILE_STORAGE__CDN_ENABLED=true
# APP_CONFIG__FILE_STORAGE__CDN_BASE_URL=http://localhost 