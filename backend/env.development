# Development Environment Configuration for Requify
# Uses MailHog for email testing

APP_CONFIG__ENV=development

# Database Configuration (Docker)
APP_CONFIG__DB__HOST=postgres
APP_CONFIG__DB__PORT=5432
APP_CONFIG__DB__NAME=requify_dev
APP_CONFIG__DB__USER=requify_user
APP_CONFIG__DB__PASSWORD=requify_password

# Test Database Configuration
APP_CONFIG__TEST_DB__HOST=postgres-test
APP_CONFIG__TEST_DB__PORT=5432
APP_CONFIG__TEST_DB__NAME=requify-test-db
APP_CONFIG__TEST_DB__USER=postgres
APP_CONFIG__TEST_DB__PASSWORD=postgres

# Redis Configuration
APP_CONFIG__REDIS__HOST=redis
APP_CONFIG__REDIS__PORT=6379
APP_CONFIG__REDIS__DB=0
APP_CONFIG__REDIS__PASSWORD=

# Security Configuration
APP_CONFIG__SECURITY__SECRET_KEY=dev-secret-key-change-in-production
APP_CONFIG__SECURITY__ACCESS_TOKEN_EXPIRE_MINUTES=30
APP_CONFIG__SECURITY__REFRESH_TOKEN_EXPIRE_DAYS=7

# Email Configuration - MailHog for Development
APP_CONFIG__EMAIL__SMTP_HOST=mailhog
APP_CONFIG__EMAIL__SMTP_PORT=1025
APP_CONFIG__EMAIL__SMTP_USER=
APP_CONFIG__EMAIL__SMTP_PASSWORD=
APP_CONFIG__EMAIL__SMTP_TLS=false
APP_CONFIG__EMAIL__SMTP_SSL=false
APP_CONFIG__EMAIL__FROM_EMAIL=noreply@requify.local
APP_CONFIG__EMAIL__FROM_NAME=Requify Development

# API Configuration
APP_CONFIG__API__CORS_ORIGINS=http://localhost:3000,http://localhost:80,http://localhost
APP_CONFIG__API__DOCS_URL=/docs
APP_CONFIG__API__REDOC_URL=/redoc

# Auth0 OAuth2 Configuration (ОТКЛЮЧЕНО в development - используется стандартная аутентификация)
APP_CONFIG__AUTH0__ENABLED=false
APP_CONFIG__AUTH0__DOMAIN=localhost
APP_CONFIG__AUTH0__CLIENT_ID=demo-local-client-id
APP_CONFIG__AUTH0__CLIENT_SECRET=demo-local-client-secret
APP_CONFIG__AUTH0__AUDIENCE=https://api.requify.com
APP_CONFIG__AUTH0__MANAGEMENT_CLIENT_ID=demo-management-client-id
APP_CONFIG__AUTH0__MANAGEMENT_CLIENT_SECRET=demo-management-client-secret

# Logging
APP_CONFIG__LOGGING__LEVEL=DEBUG
APP_CONFIG__LOGGING__FORMAT=detailed 